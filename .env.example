# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored - it never reaches GitHub.

# Atlassian account email used for Forge
FORGE_EMAIL=you@example.com
# Forge API token: id.atlassian.com -> Security -> API tokens -> "Create API token with scopes" -> app: Forge
FORGE_API_TOKEN=

# GitHub fine-grained token: this repo only, Contents = Read and write
GITHUB_TOKEN=
